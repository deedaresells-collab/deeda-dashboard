{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram-daily",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/telegram-daily",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/telegram-daily",
      "schedule": "0 0 * * *"
    }
  ]
}
